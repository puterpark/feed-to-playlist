# ── database (PostgreSQL) ─────────────────────────────
# 앱 실행용. jOOQ 코드 생성(빌드)에는 .env 가 아니라 셸 환경변수로 따로 줘야 함
# 예) jdbc:postgresql://localhost:5432/feed_to_playlist
JDBC_URL=
JDBC_USER=
JDBC_PASSWORD=

# ── site ──────────────────────────────────────────────
# 개인정보처리방침·약관 페이지에 표시할 문의 이메일
CONTACT_EMAIL=

# ── google oauth ──────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Cloud 콘솔의 승인된 리디렉션 URI 와 완전히 일치해야 함. 서버에서는 https://도메인/oauth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/oauth/google/callback
# 연결을 허용할 이메일(쉼표 구분). 비우면 누구나 연결 가능
ALLOWED_EMAILS=

# ── security ──────────────────────────────────────────
# refresh token 암호화 키. base64 32바이트: openssl rand -base64 32
# 바꾸면 저장된 refresh token을 복호화할 수 없으므로 재연결 필요
TOKEN_ENCRYPTION_KEY=

# ── poll ──────────────────────────────────────────────
# 이 시간보다 오래된 영상은 새 영상으로 취급하지 않음 (3d)  예: 72h, 3d
POLL_MAX_AGE=3d
# 구독 채널 목록 재동기화 주기 (6h)
POLL_SUBSCRIPTION_SYNC_INTERVAL=6h
# RSS 동시 요청 수 (8)
POLL_RSS_CONCURRENCY=8